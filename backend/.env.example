# ==============================================================================
# 1. CONDUIT API CONFIGURATION (Primary LLM Gateway for OpenAI / GPT-5.5)
# Paste your Conduit API Key below (from https://conduit.ozdoev.net/v1)
# ==============================================================================
CONDUIT_API_KEY=your_conduit_api_key_here
CONDUIT_BASE_URL=https://conduit.ozdoev.net/v1
# Ordered priority list of LLM models on Conduit (automatically falls back if a model is unavailable)
CONDUIT_MODELS=openai/gpt-5.5-preview,openai/gpt-5.5,gpt-4o,anthropic/claude-3-5-sonnet,meta-llama/llama-3.3-70b-instruct

# ==============================================================================
# 2. OPENROUTER FALLBACK CONFIGURATION (Optional Secondary Backup)
# If all Conduit attempts fail or rate-limit, the system automatically falls back here
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=openai/gpt-5.5-preview,openai/gpt-5.5,openai/gpt-4o,anthropic/claude-3.5-sonnet

# App Configuration
APP_TITLE="AlphaVision AI Quant & Equities Forecasting API"
APP_URL="http://localhost:3000"

# Database & Cache (Optional - System automatically falls back to SQLite and In-Memory TTL Cache!)
DATABASE_URL=
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ML and Forecasting defaults
DEFAULT_PREDICTION_HORIZONS=5,10,15,30
DEFAULT_TRAIN_WINDOWS=3M,6M,1Y
